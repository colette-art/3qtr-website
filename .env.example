# Set these in Vercel -> Project -> Settings -> Environment Variables (server-side only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
RESEND_API_KEY=re_xxxxxxxx
# Where inquiry notifications are sent (comma-separate for several).
# On Resend's free tier without a verified domain this must be your own Resend account email.
CONTACT_TO_EMAIL=you@example.com
# Optional. Leave unset to use Resend's shared onboarding@resend.dev sender.
# CONTACT_FROM_EMAIL=3QTR Website <contact@your-verified-domain.com>
